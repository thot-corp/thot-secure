# Thot Secure — dashboard web (build Vite, optionnel)
#
# URL de base de l'API. Laisser la valeur relative par défaut pour utiliser le
# proxy (dev : Vite -> 127.0.0.1:8080 ; prod : nginx -> thotsecure:8080).
# Exemple d'appel direct cross-origin : http://127.0.0.1:8080/api/v1
VITE_THOT_API_URL=/api/v1
