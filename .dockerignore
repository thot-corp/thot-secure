# =============================================================================
# Thot Secure — exclusions du contexte de build Docker
# Objectif : contexte minimal, build reproductible, aucun secret embarqué.
# =============================================================================

# --- Contrôle de version et métadonnées -------------------------------------
.git
.git/**
.gitignore
.gitattributes
.gitmodules
.github
.gitlab-ci.yml
.gitea
.hg
.hg/**
.svn
.svn/**
.bzr

