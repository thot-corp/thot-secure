{
  "name": "@thotsecure/sdk",
  "version": "0.1.0",
  "description": "SDK TypeScript officiel pour l'API REST Thot Secure (ex-Thot Secure) v0.1.0 — SOAR/CSPM défensif. Zéro dépendance runtime.",
  "license": "Apache-2.0",
  "author": "Projet Thot Secure",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "thot-secure",
    "thotsecure",
    "soar",
    "cspm",
    "security",
    "sdk",
    "defensive"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
